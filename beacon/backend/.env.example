# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If using a local Postgres install:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beacon"

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL)
CLIENT_ORIGIN="http://localhost:5173"
